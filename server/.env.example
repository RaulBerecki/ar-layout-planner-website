# Copy this file to .env and fill in the real values. Never commit .env.
DATABASE_URL=postgresql://postgres.PROJECT_ID:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=a-long-random-string-at-least-32-characters

# Optional: AI-generated names, categories and tags for uploaded models.
# Set the key of at least one provider; without any, the feature stays off and the
# application runs exactly as before.
#
# Google Gemini - key from https://aistudio.google.com (free tier, no billing needed)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
#
# Anthropic Claude - key from https://platform.claude.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
#
# Which one to use when both keys are set: gemini or anthropic.
# When unset, the first provider with a key wins (Gemini, then Claude).
# AI_PROVIDER=gemini
