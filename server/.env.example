# Copy this file to .env and fill in the real values. Never commit .env.
DATABASE_URL=postgresql://postgres.PROJECT_ID:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=a-long-random-string-at-least-32-characters

# Optional: enables AI-generated names, categories and tags for uploaded models.
# Without it the application runs exactly as before, with the feature switched off.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: use a cheaper model for bulk imports, e.g. claude-haiku-4-5
# ANTHROPIC_MODEL=claude-opus-5-5
